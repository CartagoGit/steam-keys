{
  "name": "steam-keys",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gestor local de keys de Steam y otras plataformas. Windows-first, Tauri 2 + React + TypeScript + Bun.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "bun install",
    "dev": "cd apps/desktop && bun run dev",
    "dev:tauri": "cd apps/desktop && bun run tauri dev",
    "dev:tauri:web": "cd apps/desktop && bun run tauri dev --no-watch",
    "build": "bun run build:front",
    "build:front": "cd apps/desktop && bun run build:front",
    "build:windows": "cd apps/desktop && bun run tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "build:windows:docker": "docker compose --file tools/docker/docker-compose.windows.yml up --build",
    "build:windows:native": "cd apps/desktop && bun run tauri build",
    "build:linux": "cd apps/desktop && bun run tauri build --bundles deb,appimage",
    "build:linux:docker": "docker compose --file tools/docker/docker-compose.linux.yml up --build",
    "build:macos": "cd apps/desktop && bun run tauri build --bundles dmg,app",
    "collect:bundles": "bun tools/scripts/collect-bundles.script.ts",
    "tauri": "cd apps/desktop && bun run tauri",
    "typecheck": "cd apps/desktop && bun run typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "import": "bun tools/scripts/import-txt.script.ts",
    "reconcile": "bun tools/scripts/reconcile-statuses.script.ts",
    "import:dry": "bun tools/scripts/import-txt.script.ts --dry-run",
    "export": "bun tools/scripts/export-txt.script.ts",
    "inspect:format": "bun tools/scripts/inspect-text-format.script.ts",
    "mask": "bun tools/scripts/mask-keys.script.ts",
    "audit": "bun tools/scripts/audit-secrets.script.ts",
    "db:path": "bun tools/scripts/print-db-path.script.ts",
    "db:reset": "bun tools/scripts/reset-db.script.ts",
    "backup:list": "bun tools/scripts/backup.script.ts list",
    "backup:now": "bun tools/scripts/backup.script.ts now",
    "backup:prune": "bun tools/scripts/backup.script.ts prune",
    "backup:restore": "bun tools/scripts/backup.script.ts restore",
    "clean": "bun run clean:build && bun run clean:dist",
    "clean:build": "rm -rf build",
    "clean:dist": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}