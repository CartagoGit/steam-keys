{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Keys",
  "version": "1.0.0",
  "identifier": "com.relaxingcup.steamkeys",

  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "bun run build:front",
    "frontendDist": "../../../build"
  },

  "app": {
    "windows": [
      {
        "title": "Steam Keys",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "RelaxingCup",
    "copyright": "Copyright (c) 2026 RelaxingCup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Gestor local de keys de Steam",
    "longDescription": "Gestor local de keys de Steam y otras plataformas. Base de datos SQLite propia, totalmente offline."
  },

  "plugins": {}
}