{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos minimos: SQL (la app es dueña de su base de datos) y dialogo nativo para elegir ficheros.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-close",
    "sql:allow-select",
    "sql:allow-load",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}