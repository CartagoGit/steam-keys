# ==============================================================================
#  Build de Steam Keys para Linux (.deb + .AppImage) desde Docker.
#
#    docker compose -f tools/docker/docker-compose.linux.yml up --build
#
#  A diferencia de Windows, aqui no hay cross-compile: el contenedor ya es Linux,
#  asi que el binario se compila de forma nativa y lo unico complicado son las
#  dependencias de WebKitGTK que pide Tauri.
# ==============================================================================

FROM rust:1.90-bookworm AS builder

ARG TAURI_TARGET=x86_64-unknown-linux-gnu
ARG TAURI_BUNDLES=deb,appimage

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_TERM_COLOR=always

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      file \
      wget \
      pkg-config \
      build-essential \
      patchelf \
      libwebkit2gtk-4.1-dev \
      libappindicator3-dev \
      libayatana-appindicator3-dev \
      librsvg2-dev \
      libssl-dev \
      libxdo-dev \
      file \
    && rm -rf /var/lib/apt/lists/*

# Bun, para lanzar los scripts del proyecto.
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# `tauri-cli` sin nodejs: la variante con `rustls` no lo necesita.
#
# `cargo install tauri-cli` deja el ejecutable como `cargo-tauri`, que es un
# plugin de cargo (se invoca como `cargo tauri ...`), no como binario `tauri` en
# el PATH. El enlace de abajo es para poder llamar a `tauri build` directamente.
RUN cargo install tauri-cli --version '^2' --locked \
      --no-default-features --features rustls \
    && ln -sf /usr/local/cargo/bin/cargo-tauri /usr/local/bin/tauri

RUN rustup target add "${TAURI_TARGET}"

WORKDIR /workspace

COPY package.json bun.lock tsconfig.json tsconfig.base.json ./
COPY apps/desktop/package.json ./apps/desktop/

RUN bun install --frozen-lockfile

COPY apps ./apps
COPY tools ./tools

# El script de compilacion va en `docker-compose.linux.yml` (campo `command`),
# no aqui: el `.AppImage` no se puede generar durante el build porque necesita
# FUSE, y el volumen que monta `dist/` sobre `/out` taparia lo que la imagen
# traiga ahi.